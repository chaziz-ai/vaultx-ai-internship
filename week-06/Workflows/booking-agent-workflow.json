    {
      "parameters": {
        "jsCode": "let partUsed = 'none';\nlet isFridayViolation = false;\nlet debugError = '';\nlet bookingSummary = '';\nlet bookingStartRaw = '';\n\ntry {\n  const customerChatId = $('Webhook').item.json.body.senderData.chatId;\n  const allEvents = $input.all();\n  \n  const matchingEvents = allEvents.filter(item => \n    item.json.summary && item.json.summary.includes(customerChatId)\n  );\n  \n  if (matchingEvents.length === 0) {\n    throw new Error('No matching event found for this customer');\n  }\n  \n  matchingEvents.sort((a, b) => new Date(a.json.created) - new Date(b.json.created));\n  const calendarData = matchingEvents[matchingEvents.length - 1].json;\n  \n  partUsed = calendarData.description;\n  bookingSummary = calendarData.summary;\n  \n  bookingStartRaw = calendarData.start.dateTime;\n  const bookingDate = new Date(bookingStartRaw);\n  const dayName = bookingDate.toLocaleDateString('en-US', { weekday: 'long', timeZone: 'Asia/Karachi' });\n  \n  if (dayName === 'Friday') {\n    isFridayViolation = true;\n  }\n} catch (error) {\n  partUsed = 'none';\n  debugError = error.message;\n}\n\nreturn {\n  json: {\n    output: $('AI Agent').item.json.output,\n    partUsed: partUsed,\n    partsArray: partUsed === 'none' ? [] : partUsed.split(', '),\n    isFridayViolation: isFridayViolation,\n    debugError: debugError,\n    bookingSummary: bookingSummary,\n    bookingDateTime: bookingStartRaw\n  }\n};"
      },
