    {
      "parameters": {
        "jsCode": "// DEMO thresholds (minutes). Real use: 1 din / 3 din\nconst T1 = 1;\nconst T2 = 2;\n\nconst now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  const mins = (t) => (now - new Date(t).getTime()) / 60000;\n  const en = r.language === 'en';\n  let next = null, msg = null;\n\n  if (r.status === 'new' && mins(r.created_at) >= T1) {\n    next = 'followup1';\n    msg = en\n      ? `Hi ${r.name}! You inquired about solar recently. Your ${r.system_size_kw} kW system estimate was Rs ${r.estimate_pkr}. Let us know if you have any questions, as prices are rising fast.`\n      : `Assalam o Alaikum ${r.name}! Aap ne solar ke liye inquiry ki thi. Aap ka ${r.system_size_kw} kW system ka estimate Rs ${r.estimate_pkr} tha. Koi sawal ho to bataiye, rates tezi se barh rahe hain.`;\n  } else if (r.status === 'followup1' && r.last_followup && mins(r.last_followup) >= T2) {\n    next = 'followup2';\n    msg = en\n      ? `${r.name}, have you decided about solar? We can arrange a free site visit. Reply \"VISIT\".`\n      : `${r.name}, kya aap ne solar ke baare mein faisla kiya? Hum free site visit arrange kar sakte hain. Reply karein \"VISIT\".`;\n  }\n\n  if (next) out.push({ json: { ...r, next_status: next, message: msg, chatId: `${r.phone}@c.us` } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
