    {
      "parameters": {
        "jsCode": "const allRows = $('Get row(s) in sheet').all();\nconst lastFive = allRows.slice(-5);\n\nlet historyText = \"\";\nfor (const row of lastFive) {\n  historyText += `Previous Q: ${row.json.Question}\\nPrevious A: ${row.json.Answer}\\n\\n`;\n}\n\nconst currentMessage = $('Slack Trigger').item.json.text;\n\nconst fullMessage = historyText + `Current question: ${currentMessage}`;\n\nreturn [{ json: { message: fullMessage } }];"
      },
