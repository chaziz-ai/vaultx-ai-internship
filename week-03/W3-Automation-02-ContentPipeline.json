        "jsCode": "const raw = $input.item.json.output[0].content[0].text;\nconst cleaned = raw.replace('```json', '').replace('```', '').trim();\nconst parsed = JSON.parse(cleaned);\n\nreturn {\n  json: {\n    Title: $('Google Sheets Trigger').item.json.Title,\n    Summary: parsed.summary,\n    Tags: parsed.tags,\n    Draft: parsed.draft,\n    Timestamp: new Date().toISOString()\n  }\n};"
